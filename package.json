{
  "name": "@ttthree/tokmon",
  "version": "0.2.1",
  "description": "Token usage monitor for AI coding agents — track costs, review sessions, optimize workflows",
  "type": "module",
  "license": "MIT",
  "author": "ttthree",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ttthree/tokmon.git"
  },
  "homepage": "https://github.com/ttthree/tokmon#readme",
  "bugs": {
    "url": "https://github.com/ttthree/tokmon/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "copilot-cli",
    "eureka",
    "token",
    "tokens",
    "cost",
    "usage",
    "monitor",
    "dashboard",
    "ai",
    "llm",
    "anthropic",
    "openai",
    "cli"
  ],
  "bin": {
    "tokmon": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build && chmod +x dist/cli/index.js",
    "build:web": "vite build",
    "dev": "tsx src/cli/index.ts",
    "dev:web": "vite",
    "dev:all": "tsx scripts/dev-all.ts",
    "corpus:sample": "tsx src/cli/index.ts corpus sample --out tests/corpus/snapshots/2026-04-default",
    "corpus:build-edge": "tsx tests/corpus/build-edge/build-edge.ts --out tests/corpus/snapshots/2026-04-edge",
    "corpus:regenerate-golden": "tsx tests/corpus/regenerate-golden.ts --corpus tests/corpus/snapshots/2026-04-default",
    "corpus:verify": "tsx src/cli/index.ts corpus verify tests/corpus/snapshots/2026-04-default",
    "test": "npm run test:unit",
    "test:corpus": "vitest run tests/corpus",
    "test:unit": "vitest run tests/unit tests/e2e",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "commander": "^13.1.0",
    "express": "^5.1.0",
    "minimatch": "^10.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
